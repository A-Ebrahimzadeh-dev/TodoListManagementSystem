{
  "AppSettings": {
    "Jwt": {
      "SecretKey": "PUT_YOUR_32+_CHAR_RANDOM_SECRET_KEY_HERE",
      "Issuer": "TodoListManagement.Api",
      "Audience": "TodoListManagement.Client",
      "AccessTokenExpirationMinutes": 15,
      "Algorithm": "HS256"
    },
    "Storage": {
      "RootPath": "AppData",
      "UsersFolder": "Users",
      "TaskItemsFolder": "TaskItems",
      "TodoListsFolder": "TodoLists"
    },
    "Hash": {
      "SaltSize": 16,
      "MemorySizeKB": 65536,
      "Iterations": 4,
      "DegreeOfParallelism": 2,
      "HashLength": 32
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}